# Copy to .env (git-ignored). Demos load it from the repo root or any parent of the working directory.

# --- demos: LLM provider (OpenRouter, https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- demos: set to 1 to build the agent and call the tool without any LLM request ---
GASCOIGNE_DEMO_DRY=

# --- gascoigne SDK (all optional) ---
# Path of the gascoigne CLI when it is not on PATH
GASCOIGNE_BIN=
# Where the local gascoigne server listens (default 127.0.0.1:7878)
GASCOIGNE_SERVER_ADDR=
# off = never optimize, never warn
GASCOIGNE_SDK=
