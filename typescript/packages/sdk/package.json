{
  "name": "@gascoigne-ai/sdk",
  "version": "0.1.1",
  "description": "Embed gascoigne token optimization in agent frameworks",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
